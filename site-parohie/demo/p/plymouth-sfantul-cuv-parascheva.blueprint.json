  },
  {
   "step": "runPHP",
   "code": "<?php\nrequire_once '/wordpress/wp-load.php';\n$inloc = array( 'Parohia Ortodoxă Română «Sfântul Ierarh Nicolae» adună în fiecare duminică familiile de români din Orașul Demo și din împrejurimi. Este o parohie fictivă, creată pentru a arăta cum arată un site Candela Parohiei.' => 'Parohia Ortodoxă Română «Sfânta Cuvioasă Parascheva» adună în fiecare duminică familiile de români din Plymouth și din împrejurimi. Acesta este un exemplu pregătit pentru parohie: textele și fotografiile le pune parohia.', 'Ocrotitorul parohiei este Sfântul Ierarh Nicolae, arhiepiscopul Mirelor Lichiei, prăznuit pe 6 decembrie. În ajunul hramului, copiii parohiei primesc daruri după Vecernie.' => 'Ocrotitorul parohiei este Sfânta Cuvioasă Parascheva, prăznuit pe 14 octombrie. Aici parohia spune cum își prăznuiește hramul.' );\nforeach ( get_posts( array( 'post_type' => 'any', 'numberposts' => -1, 'post_status' => 'any' ) ) as $x ) {\n  $c = strtr( $x->post_content, $inloc );\n  if ( $c !== $x->post_content ) { wp_update_post( array( 'ID' => $x->ID, 'post_content' => $c ) ); }\n}\n$it = get_page_by_path( 'italiano' );\nif ( $it ) { wp_update_post( array( 'ID' => $it->ID, 'post_title' => 'In English', 'post_name' => 'english', 'post_content' => '<!-- wp:group {\"className\":\"candela-lang-en\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group candela-lang-en\"><!-- wp:paragraph --><p>The Romanian Orthodox Parish of Sfânta Cuvioasă Parascheva welcomes Romanian families from Plymouth and the surrounding area every Sunday. The Divine Liturgy is served in Romanian; everyone is welcome.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>For baptisms, weddings or other services, write to us from the Contact page or call the parish priest.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>This is an example prepared for the parish; the texts and photos are added by the parish itself.</p><!-- /wp:paragraph --><!-- wp:candela/contact /--></div><!-- /wp:group -->' ) ); }\n"
